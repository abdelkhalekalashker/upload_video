<% content_for :title, @video.title %>

<h1><%= @video.title %></h1>

<figure class="media">
  <%= video_tag url_for(@video.clip), controls: true, preload: "metadata" %>
  <figcaption>
    <%= @video.clip.filename %> &middot; <%= number_to_human_size(@video.clip.byte_size) %>
  </figcaption>
</figure>

<div class="actions">
  <%= link_to "Back to videos", videos_path %>
  <%= button_to "Delete", @video, method: :delete, class: "button danger", form: { data: { turbo_confirm: "Delete this video?" } } %>
</div>
